10 REM NETTEST: PRUEBA DE LA CONEXION TCP DEL SDF-PICO (docs/RED.md)
20 SCREEN 0:WIDTH 40:KEY OFF:CLEAR 800
30 PRINT "SDF-Pico: prueba de CMD_NETIO":PRINT
40 S=INP(1):PRINT "1. Estado (01h):";HEX$(S)
50 IF S=255 THEN PRINT "   La Pico no contesta":END
60 OUT 1,&HB1:OUT 0,0:OUT 0,0:OUT 0,0:GOSUB 3000:R=INP(0)
70 PRINT "   NETCONN cerrar: resultado";R
80 TX$="":MX=120:GOSUB 2000
90 PRINT "   NETIO: estado";ST AND 7;", datos";LEN(RX$)
100 PRINT:PRINT "2. Modem: AT"
110 TX$="at"+CHR$(13):K$="OK":TM=300:GOSUB 2500
120 IF F THEN PRINT "   OK" ELSE PRINT "   SIN RESPUESTA: ";B$
130 PRINT:INPUT "3. Servidor (ip:puerto)";H$
140 TX$="atd"+H$+CHR$(13):K$="CONNECT":TM=1500:GOSUB 2500
150 IF F THEN PRINT "   CONECTADO" ELSE PRINT "   NO CONECTO: ";B$:END
160 PRINT:PRINT "4. (T)erminal o (V)erificar secuencia";
170 A$=INKEY$:IF A$="" THEN 170
180 PRINT A$:IF A$="v" OR A$="V" THEN 400
190 PRINT "   Terminal: lo que escribas se envia. ESC sale."
200 A$=INKEY$:IF A$=CHR$(27) THEN 300
210 TX$=A$:MX=120:GOSUB 2000:PRINT RX$;
220 IF (ST AND 4)<>0 AND LEN(RX$)=0 THEN PRINT:PRINT "[NO CARRIER]":GOTO 300
230 GOTO 200
300 OUT 1,&HB1:OUT 0,0:OUT 0,0:OUT 0,0:GOSUB 3000:R=INP(0)
310 PRINT:PRINT "Fin.":END
400 PRINT "   En el servidor: /bytes 20000  (o mas)"
410 PRINT "   ESC sale. Cuenta bytes y errores."
420 E=0:TT=0:ER=0:TIME=0
430 A$=INKEY$:IF A$=CHR$(27) THEN 470
440 GOSUB 2100
450 IF TIME>60 THEN TIME=0:PRINT "bytes";TT;"errores";ER
460 IF (ST AND 4)<>0 AND N=0 THEN 470
465 GOTO 430
470 PRINT:PRINT "Total:";TT;"bytes,";ER;"errores"
480 GOTO 300
2000 REM NETIO: envia TX$ (hasta 60), recibe hasta MX -> ST, RX$
2010 OUT 1,&HB2:OUT 0,MX:OUT 0,LEN(TX$)
2020 IF LEN(TX$)>0 THEN FOR I=1 TO LEN(TX$):OUT 0,ASC(MID$(TX$,I,1)):NEXT
2030 GOSUB 3000
2040 ST=INP(0):N=INP(0):RX$=""
2050 IF N>0 THEN FOR I=1 TO N:RX$=RX$+CHR$(INP(0)):NEXT
2060 RETURN
2100 REM NETIO que solo cuenta: comprueba la secuencia 1..255
2110 OUT 1,&HB2:OUT 0,120:OUT 0,0:GOSUB 3000
2120 ST=INP(0):N=INP(0)
2125 IF N=0 THEN RETURN
2130 FOR I=1 TO N:B=INP(0)
2140 IF E=0 AND B<>1 THEN 2190
2150 IF E=0 THEN E=1:TT=0
2160 IF B<>E THEN ER=ER+1:E=B
2170 E=E MOD 255+1:TT=TT+1
2190 NEXT:RETURN
2500 REM envia TX$ y junta lo recibido en B$ hasta ver K$ o pasar TM jiffies
2510 B$="":F=0:TIME=0
2520 MX=120:GOSUB 2000:B$=B$+RX$:TX$=""
2530 IF LEN(B$)>200 THEN B$=RIGHT$(B$,100)
2540 IF INSTR(B$,K$)>0 THEN F=-1:RETURN
2550 IF TIME<TM THEN 2520
2560 RETURN
3000 REM espera a que la Pico baje OCUPADO (bit 7 del estado)
3010 T=0
3020 S=INP(1):IF S=255 THEN PRINT "La Pico no contesta":END
3030 IF (S AND 128)<>0 AND T<3000 THEN T=T+1:GOTO 3020
3040 IF T>=3000 THEN PRINT "Tiempo agotado":END
3050 RETURN
